# Kopier til .env. Begge er offentlige verdier som havner i frontend-bundelen,
# men .env er likevel gitignorert for å holde lokale og produksjonsverdier fra
# hverandre.
VITE_SUPABASE_URL=https://hggzbixirdaamvkjvgul.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Mot en lokal stack (npm run db:start) gir CLI-en deg verdiene å bruke i stedet:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_KEY=<anon key fra `npx supabase status`>

# Hemmelighetene edge-funksjonene trenger settes IKKE her, men som
# Supabase-secrets. Se docs/DRIFT.md:
#   RESEND_API_KEY, REMINDER_FROM, APP_URL
